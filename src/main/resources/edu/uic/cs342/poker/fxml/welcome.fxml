<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.uic.cs342.poker.controller.WelcomeController" alignment="CENTER" spacing="22" styleClass="app-root">
  <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
  <Label text="♠  ♥  ♣  ♦" styleClass="suits"/>
  <Label text="THREE CARD POKER" styleClass="title"/>
  <Label text="Two players. One dealer. Each hand is your own." styleClass="subtitle"/>
  <Button text="Start Game" onAction="#start" defaultButton="true" prefWidth="280" styleClass="primary"/>
  <Button text="How to Play" onAction="#help" prefWidth="280"/>
  <Button text="Exit" onAction="#exit" prefWidth="280"/>
  <HBox alignment="CENTER" spacing="20"><Button text="Switch Theme" onAction="#theme"/></HBox>
  <Label text="Keyboard: Tab to move, Enter or Space to select." styleClass="muted"/>
</VBox>
